<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:senku="http://senku/carta" id="Definicoes.Processo_SUP-01" targetNamespace="http://senku/processos" exporter="Senku" exporterVersion="2">
  <bpmn:collaboration id="Colaboracao.Processo_SUP-01">
    <bpmn:participant id="Pool.Processo_SUP-01" name="SUP-01 · Compra de materiais indiretos" processRef="Processo_SUP-01"/>
  </bpmn:collaboration>
  <bpmn:process id="Processo_SUP-01" name="SUP-01 · Compra de materiais indiretos" isExecutable="false">
    <bpmn:documentation>Entregar ao solicitante o material de uso interno (escritório, manutenção, TI) no prazo combinado, pelo menor custo total e com a despesa autorizada.</bpmn:documentation>
    <bpmn:extensionElements><senku:carta>{&quot;formato&quot;:&quot;senku/1&quot;,&quot;processo&quot;:{&quot;codigo&quot;:&quot;SUP-01&quot;,&quot;nome&quot;:&quot;Compra de materiais indiretos&quot;,&quot;cenario&quot;:&quot;as-is&quot;,&quot;versao&quot;:&quot;0.3&quot;,&quot;objetivo&quot;:&quot;Entregar ao solicitante o material de uso interno (escritório, manutenção, TI) no prazo combinado, pelo menor custo total e com a despesa autorizada.&quot;,&quot;dono&quot;:&quot;Gerente de Suprimentos&quot;,&quot;area&quot;:&quot;Suprimentos&quot;,&quot;macroprocesso&quot;:&quot;Gestão de suprimentos&quot;,&quot;nivel&quot;:&quot;processo&quot;,&quot;gatilho&quot;:&quot;Uma área precisa de material que não há no estoque&quot;,&quot;resultado&quot;:&quot;Material entregue ao solicitante e nota fiscal lançada para pagamento&quot;,&quot;frequencia&quot;:&quot;contínuo&quot;,&quot;volume&quot;:&quot;cerca de 120 requisições por mês&quot;,&quot;prazo_informado&quot;:&quot;de 10 a 15 dias úteis (prazo combinado: 10 dias úteis)&quot;,&quot;escopo&quot;:{&quot;inicio&quot;:&quot;Solicitante abre a requisição de compra&quot;,&quot;fim&quot;:&quot;Nota fiscal lançada no contas a pagar e material entregue&quot;,&quot;inclui&quot;:[&quot;materiais indiretos até R$ 50 mil&quot;],&quot;nao_inclui&quot;:[&quot;compra de matéria-prima (processo SUP-02)&quot;,&quot;pagamento ao fornecedor (processo FIN-03)&quot;,&quot;contratação de serviços&quot;]},&quot;normas&quot;:[&quot;Política de Compras PC-001 rev. 4&quot;,&quot;Tabela de alçadas 2026&quot;],&quot;premissas&quot;:[&quot;Tempos estimados na entrevista de 28/10/2026, não medidos no sistema&quot;]},&quot;sipoc&quot;:{&quot;fornecedores&quot;:[&quot;Áreas solicitantes&quot;,&quot;Fornecedores cadastrados&quot;,&quot;Controladoria (orçamento)&quot;],&quot;entradas&quot;:[&quot;Necessidade de material&quot;,&quot;Orçamento da área&quot;,&quot;Cotações&quot;,&quot;Nota fiscal&quot;],&quot;saidas&quot;:[&quot;Pedido de compra&quot;,&quot;Material entregue&quot;,&quot;Nota fiscal lançada&quot;],&quot;clientes&quot;:[&quot;Área solicitante&quot;,&quot;Contas a pagar&quot;]},&quot;papeis&quot;:[{&quot;id&quot;:&quot;solicitante&quot;,&quot;nome&quot;:&quot;Solicitante&quot;,&quot;tipo&quot;:&quot;interno&quot;},{&quot;id&quot;:&quot;gestor&quot;,&quot;nome&quot;:&quot;Gestor da área&quot;,&quot;tipo&quot;:&quot;interno&quot;},{&quot;id&quot;:&quot;compras&quot;,&quot;nome&quot;:&quot;Comprador&quot;,&quot;tipo&quot;:&quot;interno&quot;},{&quot;id&quot;:&quot;fornecedor&quot;,&quot;nome&quot;:&quot;Fornecedor&quot;,&quot;tipo&quot;:&quot;externo&quot;},{&quot;id&quot;:&quot;almox&quot;,&quot;nome&quot;:&quot;Almoxarifado&quot;,&quot;tipo&quot;:&quot;interno&quot;},{&quot;id&quot;:&quot;fiscal&quot;,&quot;nome&quot;:&quot;Fiscal / Contas a pagar&quot;,&quot;tipo&quot;:&quot;interno&quot;}],&quot;sistemas&quot;:[{&quot;id&quot;:&quot;erp&quot;,&quot;nome&quot;:&quot;ERP&quot;},{&quot;id&quot;:&quot;email&quot;,&quot;nome&quot;:&quot;E-mail&quot;},{&quot;id&quot;:&quot;planilha&quot;,&quot;nome&quot;:&quot;Planilha de cotações&quot;}],&quot;regras&quot;:[{&quot;id&quot;:&quot;R1&quot;,&quot;texto&quot;:&quot;O gestor aprova até R$ 10 mil; acima disso, também o diretor da área (Tabela de alçadas 2026).&quot;,&quot;fonte&quot;:&quot;Tabela de alçadas 2026&quot;},{&quot;id&quot;:&quot;R2&quot;,&quot;texto&quot;:&quot;Compras acima de R$ 5 mil exigem no mínimo 3 cotações.&quot;,&quot;fonte&quot;:&quot;PC-001, item 4.2&quot;},{&quot;id&quot;:&quot;R3&quot;,&quot;texto&quot;:&quot;Vence o menor custo total (preço + frete + prazo), entre fornecedores homologados.&quot;,&quot;fonte&quot;:&quot;PC-001, item 4.5&quot;},{&quot;id&quot;:&quot;R4&quot;,&quot;texto&quot;:&quot;Quantidade e especificação devem bater com o pedido; divergência acima de 2% é devolvida.&quot;,&quot;fonte&quot;:&quot;Prática do almoxarifado&quot;},{&quot;id&quot;:&quot;R5&quot;,&quot;texto&quot;:&quot;A nota só é lançada com pedido de compra aprovado (conferência de 3 vias: pedido, recebimento, nota).&quot;,&quot;fonte&quot;:&quot;Controladoria&quot;}],&quot;indicadores&quot;:[{&quot;nome&quot;:&quot;Lead time da requisição&quot;,&quot;objetivo&quot;:&quot;Prazo que o solicitante sente&quot;,&quot;formula&quot;:&quot;data de entrega ao solicitante - data de abertura da requisição (dias úteis)&quot;,&quot;meta&quot;:&quot;≤ 10 dias úteis&quot;,&quot;polaridade&quot;:&quot;menor é melhor&quot;,&quot;periodicidade&quot;:&quot;mensal&quot;,&quot;fonte&quot;:&quot;ERP&quot;,&quot;dono&quot;:&quot;Gerente de Suprimentos&quot;,&quot;atual&quot;:&quot;14 dias úteis (estimado na entrevista)&quot;},{&quot;nome&quot;:&quot;Requisições devolvidas para correção&quot;,&quot;formula&quot;:&quot;requisições reprovadas / requisições analisadas&quot;,&quot;meta&quot;:&quot;≤ 5%&quot;,&quot;polaridade&quot;:&quot;menor é melhor&quot;,&quot;periodicidade&quot;:&quot;mensal&quot;,&quot;fonte&quot;:&quot;ERP&quot;,&quot;dono&quot;:&quot;Gerente de Suprimentos&quot;,&quot;atual&quot;:&quot;≈ 25% (estimado)&quot;},{&quot;nome&quot;:&quot;Saving de compras&quot;,&quot;formula&quot;:&quot;(maior cotação - cotação escolhida) / maior cotação&quot;,&quot;meta&quot;:&quot;≥ 8%&quot;,&quot;polaridade&quot;:&quot;maior é melhor&quot;,&quot;periodicidade&quot;:&quot;trimestral&quot;,&quot;fonte&quot;:&quot;Planilha de cotações&quot;,&quot;dono&quot;:&quot;Gerente de Suprimentos&quot;,&quot;atual&quot;:&quot;não medido hoje&quot;}],&quot;dores&quot;:[{&quot;id&quot;:&quot;D1&quot;,&quot;descricao&quot;:&quot;Requisição volta para correção porque falta centro de custo ou especificação.&quot;,&quot;elementos&quot;:[&quot;a1&quot;,&quot;d1&quot;],&quot;impacto&quot;:&quot;alto&quot;,&quot;frequencia&quot;:&quot;15% das requisições&quot;},{&quot;id&quot;:&quot;D2&quot;,&quot;descricao&quot;:&quot;A cotação é redigitada da planilha para o ERP, com erro de preço às vezes.&quot;,&quot;elementos&quot;:[&quot;a5&quot;],&quot;impacto&quot;:&quot;médio&quot;},{&quot;id&quot;:&quot;D3&quot;,&quot;descricao&quot;:&quot;Aprovação do gestor fica parada dias na caixa de entrada.&quot;,&quot;elementos&quot;:[&quot;a2&quot;],&quot;impacto&quot;:&quot;alto&quot;}],&quot;riscos&quot;:[{&quot;id&quot;:&quot;K1&quot;,&quot;descricao&quot;:&quot;Pagamento de nota sem material recebido&quot;,&quot;elementos&quot;:[&quot;a9&quot;],&quot;controle&quot;:&quot;Conferência de 3 vias no lançamento (R5)&quot;,&quot;tipo_controle&quot;:&quot;preventivo&quot;,&quot;probabilidade&quot;:&quot;baixa&quot;,&quot;impacto&quot;:&quot;alto&quot;},{&quot;id&quot;:&quot;K2&quot;,&quot;descricao&quot;:&quot;Compra direcionada a um fornecedor&quot;,&quot;elementos&quot;:[&quot;a3&quot;,&quot;a4&quot;],&quot;controle&quot;:&quot;Mínimo de 3 cotações acima de R$ 5 mil (R2)&quot;,&quot;tipo_controle&quot;:&quot;preventivo&quot;,&quot;probabilidade&quot;:&quot;média&quot;,&quot;impacto&quot;:&quot;alto&quot;}],&quot;melhorias&quot;:[{&quot;id&quot;:&quot;M1&quot;,&quot;descricao&quot;:&quot;Campos obrigatórios e catálogo de itens na requisição do ERP&quot;,&quot;resolve&quot;:[&quot;D1&quot;],&quot;elementos&quot;:[&quot;a1&quot;],&quot;impacto&quot;:&quot;alto&quot;,&quot;esforco&quot;:&quot;baixo&quot;,&quot;responsavel&quot;:&quot;Analista de TI do ERP&quot;,&quot;prazo&quot;:&quot;30/11/2026&quot;,&quot;status&quot;:&quot;aprovada&quot;},{&quot;id&quot;:&quot;M2&quot;,&quot;descricao&quot;:&quot;Cotação direto no ERP (portal do fornecedor), sem planilha&quot;,&quot;resolve&quot;:[&quot;D2&quot;],&quot;elementos&quot;:[&quot;a3&quot;,&quot;a5&quot;],&quot;impacto&quot;:&quot;médio&quot;,&quot;esforco&quot;:&quot;médio&quot;,&quot;responsavel&quot;:&quot;Gerente de Suprimentos&quot;,&quot;prazo&quot;:&quot;31/03/2027&quot;,&quot;status&quot;:&quot;proposta&quot;},{&quot;id&quot;:&quot;M3&quot;,&quot;descricao&quot;:&quot;Aprovação pelo celular com lembrete automático em 24h e SLA de 1 dia útil&quot;,&quot;resolve&quot;:[&quot;D3&quot;],&quot;elementos&quot;:[&quot;a2&quot;],&quot;impacto&quot;:&quot;alto&quot;,&quot;esforco&quot;:&quot;baixo&quot;,&quot;responsavel&quot;:&quot;Gerente de Suprimentos&quot;,&quot;prazo&quot;:&quot;15/12/2026&quot;,&quot;status&quot;:&quot;em andamento&quot;}],&quot;glossario&quot;:[{&quot;termo&quot;:&quot;Material indireto&quot;,&quot;definicao&quot;:&quot;Material que não entra no produto vendido (escritório, manutenção, TI).&quot;},{&quot;termo&quot;:&quot;Conferência de 3 vias&quot;,&quot;definicao&quot;:&quot;Pedido, recebimento e nota fiscal precisam bater antes do lançamento.&quot;}],&quot;pendencias&quot;:[{&quot;pergunta&quot;:&quot;Confirmar com a Controladoria se a alçada de R$ 10 mil vale para TI.&quot;,&quot;para&quot;:&quot;Controladoria&quot;}]}</senku:carta></bpmn:extensionElements>
    <bpmn:laneSet id="Raias.Processo_SUP-01">
      <bpmn:lane id="Raia_solicitante" name="Solicitante">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_gestor" name="Gestor da área">
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_compras" name="Comprador">
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_fornecedor" name="Fornecedor">
        <bpmn:flowNodeRef>f_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a7r</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_almox" name="Almoxarifado">
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_fiscal" name="Fiscal / Contas a pagar">
        <bpmn:flowNodeRef>a9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Necessidade de material identificada">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;inicio&quot;,&quot;tipo&quot;:&quot;inicio&quot;,&quot;nome&quot;:&quot;Necessidade de material identificada&quot;,&quot;papel&quot;:&quot;solicitante&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:outgoing>Fluxo_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a1" name="Preencher requisição de compra">
      <bpmn:documentation>Abre a requisição no ERP com item, quantidade, centro de custo e justificativa.&#10;Sistema: ERP&#10;Tempo: execução 15min, espera 0&#10;Valor: NAV-N</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a1&quot;,&quot;nome&quot;:&quot;Preencher requisição de compra&quot;,&quot;papel&quot;:&quot;solicitante&quot;,&quot;sistema&quot;:&quot;erp&quot;,&quot;descricao&quot;:&quot;Abre a requisição no ERP com item, quantidade, centro de custo e justificativa.&quot;,&quot;saidas&quot;:[&quot;Requisição de compra&quot;],&quot;tempo&quot;:{&quot;execucao&quot;:&quot;15min&quot;,&quot;espera&quot;:&quot;0&quot;},&quot;valor&quot;:&quot;NAV-N&quot;,&quot;_doc&quot;:&quot;Abre a requisição no ERP com item, quantidade, centro de custo e justificativa. Sistema: ERP Tempo: execução 15min, espera 0 Valor: NAV-N&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f1</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a2" name="Analisar requisição">
      <bpmn:documentation>Confere necessidade, centro de custo e saldo de orçamento.&#10;Sistema: ERP&#10;Tempo: execução 10min, espera 2d&#10;Regra R1: O gestor aprova até R$ 10 mil; acima disso, também o diretor da área (Tabela de alçadas 2026).&#10;Valor: NAV-N</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a2&quot;,&quot;nome&quot;:&quot;Analisar requisição&quot;,&quot;papel&quot;:&quot;gestor&quot;,&quot;sistema&quot;:&quot;erp&quot;,&quot;descricao&quot;:&quot;Confere necessidade, centro de custo e saldo de orçamento.&quot;,&quot;regras&quot;:[&quot;R1&quot;],&quot;tempo&quot;:{&quot;execucao&quot;:&quot;10min&quot;,&quot;espera&quot;:&quot;2d&quot;},&quot;valor&quot;:&quot;NAV-N&quot;,&quot;raci&quot;:{&quot;A&quot;:&quot;gestor&quot;,&quot;I&quot;:[&quot;solicitante&quot;]},&quot;_doc&quot;:&quot;Confere necessidade, centro de custo e saldo de orçamento. Sistema: ERP Tempo: execução 10min, espera 2d Regra R1: O gestor aprova até R$ 10 mil; acima disso, também o diretor da área (Tabela de alçadas 2026). Valor: NAV-N&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f2</bpmn:incoming>
      <bpmn:incoming>Fluxo_f6</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="d1" name="Requisição aprovada?">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;d1&quot;,&quot;tipo&quot;:&quot;decisao&quot;,&quot;nome&quot;:&quot;Requisição aprovada?&quot;,&quot;papel&quot;:&quot;gestor&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f3</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f4</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a1b" name="Corrigir requisição">
      <bpmn:documentation>Sistema: ERP&#10;Tempo: execução 10min, espera 1d&#10;Valor: NAV</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a1b&quot;,&quot;nome&quot;:&quot;Corrigir requisição&quot;,&quot;papel&quot;:&quot;solicitante&quot;,&quot;sistema&quot;:&quot;erp&quot;,&quot;tempo&quot;:{&quot;execucao&quot;:&quot;10min&quot;,&quot;espera&quot;:&quot;1d&quot;},&quot;valor&quot;:&quot;NAV&quot;,&quot;_doc&quot;:&quot;Sistema: ERP Tempo: execução 10min, espera 1d Valor: NAV&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f5</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a3" name="Cotar com fornecedores">
      <bpmn:documentation>Pede cotação por e-mail e consolida as propostas na planilha.&#10;Sistema: E-mail, Planilha de cotações&#10;Tempo: execução 1h, espera 3d&#10;Regra R2: Compras acima de R$ 5 mil exigem no mínimo 3 cotações.&#10;Valor: NAV-N</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a3&quot;,&quot;nome&quot;:&quot;Cotar com fornecedores&quot;,&quot;papel&quot;:&quot;compras&quot;,&quot;sistema&quot;:[&quot;email&quot;,&quot;planilha&quot;],&quot;descricao&quot;:&quot;Pede cotação por e-mail e consolida as propostas na planilha.&quot;,&quot;regras&quot;:[&quot;R2&quot;],&quot;saidas&quot;:[&quot;Mapa de cotação&quot;],&quot;tempo&quot;:{&quot;execucao&quot;:&quot;1h&quot;,&quot;espera&quot;:&quot;3d&quot;},&quot;valor&quot;:&quot;NAV-N&quot;,&quot;_doc&quot;:&quot;Pede cotação por e-mail e consolida as propostas na planilha. Sistema: E-mail, Planilha de cotações Tempo: execução 1h, espera 3d Regra R2: Compras acima de R$ 5 mil exigem no mínimo 3 cotações. Valor: NAV-N&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f4</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="f_cot" name="Enviar proposta">
      <bpmn:documentation>Sistema: E-mail&#10;Tempo: execução 1h, espera 2d&#10;Valor: VA</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;f_cot&quot;,&quot;nome&quot;:&quot;Enviar proposta&quot;,&quot;papel&quot;:&quot;fornecedor&quot;,&quot;sistema&quot;:&quot;email&quot;,&quot;tempo&quot;:{&quot;execucao&quot;:&quot;1h&quot;,&quot;espera&quot;:&quot;2d&quot;},&quot;valor&quot;:&quot;VA&quot;,&quot;_doc&quot;:&quot;Sistema: E-mail Tempo: execução 1h, espera 2d Valor: VA&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f7</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a4" name="Escolher fornecedor">
      <bpmn:documentation>Sistema: Planilha de cotações&#10;Tempo: execução 30min&#10;Regra R3: Vence o menor custo total (preço + frete + prazo), entre fornecedores homologados.&#10;Valor: VA</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a4&quot;,&quot;nome&quot;:&quot;Escolher fornecedor&quot;,&quot;papel&quot;:&quot;compras&quot;,&quot;sistema&quot;:&quot;planilha&quot;,&quot;regras&quot;:[&quot;R3&quot;],&quot;tempo&quot;:{&quot;execucao&quot;:&quot;30min&quot;},&quot;valor&quot;:&quot;VA&quot;,&quot;_doc&quot;:&quot;Sistema: Planilha de cotações Tempo: execução 30min Regra R3: Vence o menor custo total (preço + frete + prazo), entre fornecedores homologados. Valor: VA&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f8</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a5" name="Lançar cotação no ERP">
      <bpmn:documentation>Redigita no ERP os preços que já estão na planilha.&#10;Sistema: ERP&#10;Tempo: execução 20min&#10;Valor: NAV</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a5&quot;,&quot;nome&quot;:&quot;Lançar cotação no ERP&quot;,&quot;papel&quot;:&quot;compras&quot;,&quot;sistema&quot;:&quot;erp&quot;,&quot;descricao&quot;:&quot;Redigita no ERP os preços que já estão na planilha.&quot;,&quot;tempo&quot;:{&quot;execucao&quot;:&quot;20min&quot;},&quot;valor&quot;:&quot;NAV&quot;,&quot;_doc&quot;:&quot;Redigita no ERP os preços que já estão na planilha. Sistema: ERP Tempo: execução 20min Valor: NAV&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f9</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a6" name="Emitir pedido de compra">
      <bpmn:documentation>Sistema: ERP&#10;Tempo: execução 10min&#10;Valor: VA</bpmn:documentation>
