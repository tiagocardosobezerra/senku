<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:process id="onboarding" name="Onboarding de fornecedor" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Cadastro solicitado"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Activity_val" name="Validar CNPJ na Receita"><bpmn:extensionElements><zeebe:taskDefinition type="cnpj" /></bpmn:extensionElements><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_err" name="CNPJ inválido" attachedToRef="Activity_val"><bpmn:outgoing>Flow_e</bpmn:outgoing><bpmn:errorEventDefinition id="ErrDef" errorRef="Error_1" /></bpmn:boundaryEvent>
    <bpmn:parallelGateway id="Gateway_fork"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:callActivity id="Activity_call" name="Avaliar risco do fornecedor"><bpmn:extensionElements><zeebe:calledElement processId="risco" /></bpmn:extensionElements><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:callActivity>
    <bpmn:subProcess id="Activity_sub" name="Coletar documentos"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:startEvent id="sub_s"><bpmn:outgoing>sf1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="sub_t1" name="Solicitar contrato social"><bpmn:incoming>sf1</bpmn:incoming><bpmn:outgoing>sf2</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="sub_t2" name="Conferir contrato social"><bpmn:incoming>sf2</bpmn:incoming><bpmn:outgoing>sf3</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="sub_e"><bpmn:incoming>sf3</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="sf1" sourceRef="sub_s" targetRef="sub_t1" /><bpmn:sequenceFlow id="sf2" sourceRef="sub_t1" targetRef="sub_t2" /><bpmn:sequenceFlow id="sf3" sourceRef="sub_t2" targetRef="sub_e" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="Gateway_join"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_dec" name="Risco aceitável?" default="Flow_nao"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_sim</bpmn:outgoing><bpmn:outgoing>Flow_nao</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_hom" name="Homologar fornecedor"><bpmn:incoming>Flow_sim</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_wait" name="Aguardar 30 dias"><bpmn:incoming>Flow_nao</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration>P30D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_ok" name="Fornecedor homologado"><bpmn:incoming>Flow_8</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_rej" name="Fornecedor recusado"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:incoming>Flow_e</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_val" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_val" targetRef="Gateway_fork" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_fork" targetRef="Activity_call" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_fork" targetRef="Activity_sub" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_call" targetRef="Gateway_join" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_sub" targetRef="Gateway_join" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_join" targetRef="Gateway_dec" />
    <bpmn:sequenceFlow id="Flow_sim" name="Sim" sourceRef="Gateway_dec" targetRef="Activity_hom"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=risco &lt; 3</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_nao" sourceRef="Gateway_dec" targetRef="Event_wait" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_hom" targetRef="End_ok" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Event_wait" targetRef="End_rej" />
    <bpmn:sequenceFlow id="Flow_e" sourceRef="Event_err" targetRef="End_rej" />
  </bpmn:process>
</bpmn:definitions>
