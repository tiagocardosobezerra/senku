<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:senku="http://senku/carta" id="Definicoes.Processo_senku" targetNamespace="http://senku/processos" exporter="Senku" exporterVersion="2">
  <bpmn:message id="Msg.a2_2" name="Segurado desistiu"/>
  <bpmn:collaboration id="Colaboracao.Processo_senku">
    <bpmn:participant id="Pool.Processo_senku" name="Análise de sinistro" processRef="Processo_senku"/>
  </bpmn:collaboration>
  <bpmn:process id="Processo_senku" name="Análise de sinistro" isExecutable="false">
    <bpmn:extensionElements><senku:carta>{&quot;processo&quot;:{&quot;nome&quot;:&quot;Análise de sinistro&quot;,&quot;volume&quot;:&quot;300 por mês&quot;},&quot;papeis&quot;:[{&quot;id&quot;:&quot;an&quot;,&quot;nome&quot;:&quot;Analista&quot;},{&quot;id&quot;:&quot;sup&quot;,&quot;nome&quot;:&quot;Supervisor&quot;},{&quot;id&quot;:&quot;cli&quot;,&quot;nome&quot;:&quot;Segurado&quot;,&quot;tipo&quot;:&quot;externo&quot;}]}</senku:carta></bpmn:extensionElements>
    <bpmn:laneSet id="Raias.Processo_senku">
      <bpmn:lane id="Raia_an" name="Analista">
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_sup" name="Supervisor de sinistros">
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_cli" name="Segurado">
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i" name="Sinistro aberto">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;i&quot;,&quot;tipo&quot;:&quot;inicio&quot;,&quot;nome&quot;:&quot;Sinistro aberto&quot;,&quot;papel&quot;:&quot;cli&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:outgoing>Fluxo_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="a1" name="Enviar documentos">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a1&quot;,&quot;nome&quot;:&quot;Enviar documentos&quot;,&quot;papel&quot;:&quot;cli&quot;,&quot;sistema&quot;:[]}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f1</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a2" name="Analisar sinistro">
      <bpmn:documentation>Tempo: execucao 2h, espera 3d</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a2&quot;,&quot;nome&quot;:&quot;Analisar sinistro&quot;,&quot;papel&quot;:&quot;an&quot;,&quot;sistema&quot;:[],&quot;tempo&quot;:{&quot;execucao&quot;:&quot;2h&quot;,&quot;espera&quot;:&quot;3d&quot;},&quot;bordas&quot;:[{&quot;gatilho&quot;:&quot;tempo&quot;,&quot;nome&quot;:&quot;Prazo de 48h estourado&quot;,&quot;tempo&quot;:&quot;48hc&quot;,&quot;percentual&quot;:10,&quot;segue&quot;:&quot;a3&quot;},{&quot;gatilho&quot;:&quot;mensagem&quot;,&quot;nome&quot;:&quot;Segurado desistiu&quot;,&quot;percentual&quot;:5,&quot;segue&quot;:&quot;f2&quot;},{&quot;gatilho&quot;:&quot;erro&quot;,&quot;nome&quot;:&quot;Fraude detectada&quot;,&quot;percentual&quot;:2,&quot;segue&quot;:&quot;a5&quot;},{&quot;gatilho&quot;:&quot;tempo&quot;,&quot;nome&quot;:&quot;Lembrete de 24h&quot;,&quot;tempo&quot;:&quot;24hc&quot;,&quot;interrompe&quot;:false,&quot;percentual&quot;:30,&quot;segue&quot;:&quot;a4&quot;},{&quot;gatilho&quot;:&quot;sinal&quot;,&quot;nome&quot;:&quot;Catástrofe declarada&quot;,&quot;percentual&quot;:1,&quot;segue&quot;:&quot;a2&quot;},{&quot;gatilho&quot;:&quot;condicao&quot;,&quot;nome&quot;:&quot;Valor revisto acima de 100 mil&quot;,&quot;percentual&quot;:3,&quot;segue&quot;:&quot;a3&quot;}]}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f2</bpmn:incoming>
      <bpmn:incoming>Fluxo_f13</bpmn:incoming>
      <bpmn:incoming>Fluxo_f16</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="a2_1" name="Prazo de 48h estourado" attachedToRef="a2">
      <bpmn:documentation>Tempo: espera 48hc</bpmn:documentation>
      <bpmn:outgoing>Fluxo_f5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="a2_1.def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="a2_2" name="Segurado desistiu" attachedToRef="a2">
      <bpmn:outgoing>Fluxo_f7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a2_2.def" messageRef="Msg.a2_2"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="a2_3" name="Fraude detectada" attachedToRef="a2">
      <bpmn:outgoing>Fluxo_f9</bpmn:outgoing>
      <bpmn:errorEventDefinition id="a2_3.def"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="a2_4" name="Lembrete de 24h" attachedToRef="a2" cancelActivity="false">
      <bpmn:documentation>Tempo: espera 24hc</bpmn:documentation>
      <bpmn:outgoing>Fluxo_f11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="a2_4.def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="a2_5" name="Catástrofe declarada" attachedToRef="a2">
      <bpmn:outgoing>Fluxo_f13</bpmn:outgoing>
      <bpmn:signalEventDefinition id="a2_5.def"/>
    </bpmn:boundaryEvent>
    
    <bpmn:task id="a3" name="Escalar ao supervisor">
      <bpmn:documentation>Tempo: execucao 30min</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a3&quot;,&quot;nome&quot;:&quot;Escalar ao supervisor&quot;,&quot;papel&quot;:&quot;sup&quot;,&quot;sistema&quot;:[],&quot;tempo&quot;:{&quot;execucao&quot;:&quot;30min&quot;}}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f5</bpmn:incoming>
      
      <bpmn:outgoing>Fluxo_f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a4" name="Avisar analista">
      <bpmn:documentation>Tempo: execucao 5min</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a4&quot;,&quot;nome&quot;:&quot;Avisar analista&quot;,&quot;papel&quot;:&quot;sup&quot;,&quot;sistema&quot;:[],&quot;tempo&quot;:{&quot;execucao&quot;:&quot;5min&quot;}}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f11</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a5" name="Abrir investigação">
      <bpmn:documentation>Tempo: execucao 1h</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a5&quot;,&quot;nome&quot;:&quot;Abrir investigação&quot;,&quot;papel&quot;:&quot;sup&quot;,&quot;sistema&quot;:[],&quot;tempo&quot;:{&quot;execucao&quot;:&quot;1h&quot;}}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f9</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="d1" name="Sinistro coberto?">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;d1&quot;,&quot;tipo&quot;:&quot;decisao&quot;,&quot;nome&quot;:&quot;Sinistro coberto?&quot;,&quot;papel&quot;:&quot;an&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f3</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f19</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_f20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a6" name="Pagar indenização">
      <bpmn:documentation>Tempo: execucao 30min</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a6&quot;,&quot;nome&quot;:&quot;Pagar indenização&quot;,&quot;papel&quot;:&quot;an&quot;,&quot;sistema&quot;:[],&quot;tempo&quot;:{&quot;execucao&quot;:&quot;30min&quot;}}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f19</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="f1" name="Indenização paga">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;f1&quot;,&quot;tipo&quot;:&quot;fim&quot;,&quot;nome&quot;:&quot;Indenização paga&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="f2" name="Sinistro encerrado sem pagamento">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;f2&quot;,&quot;tipo&quot;:&quot;fim&quot;,&quot;nome&quot;:&quot;Sinistro encerrado sem pagamento&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f7</bpmn:incoming>
      <bpmn:incoming>Fluxo_f20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="f3" name="Lembrete enviado">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;f3&quot;,&quot;tipo&quot;:&quot;fim&quot;,&quot;nome&quot;:&quot;Lembrete enviado&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="f4" name="Investigação aberta">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;f4&quot;,&quot;tipo&quot;:&quot;fim&quot;,&quot;nome&quot;:&quot;Investigação aberta&quot;,&quot;encerra&quot;:true}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f18</bpmn:incoming>
      <bpmn:terminateEventDefinition id="f4.def"/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_f1" sourceRef="i" targetRef="a1"/>
    <bpmn:sequenceFlow id="Fluxo_f2" sourceRef="a1" targetRef="a2"/>
    <bpmn:sequenceFlow id="Fluxo_f3" sourceRef="a2" targetRef="d1"/>
    <bpmn:sequenceFlow id="Fluxo_f5" sourceRef="a2_1" targetRef="a3"/>
