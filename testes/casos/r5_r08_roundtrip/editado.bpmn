    <bpmn:sequenceFlow id="Fluxo_f16" sourceRef="a3" targetRef="a2"/>
    <bpmn:sequenceFlow id="Fluxo_f17" sourceRef="a4" targetRef="f3"/>
    <bpmn:sequenceFlow id="Fluxo_f18" sourceRef="a5" targetRef="f4"/>
    <bpmn:sequenceFlow id="Fluxo_f19" sourceRef="d1" targetRef="a6" name="Sim">
      <bpmn:documentation>80% dos casos</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;percentual&quot;:80.0}</senku:dados></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_f20" sourceRef="d1" targetRef="f2" name="Não">
      <bpmn:documentation>20% dos casos</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;percentual&quot;:20.0}</senku:dados></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_f21" sourceRef="a6" targetRef="f1"/>
  </bpmn:process>
