    <bpmn:endEvent id="f" name="Reembolso pago">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;f&quot;,&quot;tipo&quot;:&quot;fim&quot;,&quot;nome&quot;:&quot;Reembolso pago&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="f2" name="Reembolso negado">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;f2&quot;,&quot;tipo&quot;:&quot;fim&quot;,&quot;nome&quot;:&quot;Reembolso negado&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_f1" sourceRef="i" targetRef="a1"/>
    <bpmn:sequenceFlow id="Fluxo_f2" sourceRef="a1" targetRef="d1"/>
    <bpmn:sequenceFlow id="Fluxo_f3" sourceRef="d1" targetRef="a2" name="Sim"/>
    <bpmn:sequenceFlow id="Fluxo_f4" sourceRef="d1" targetRef="d2" name="Não"/>
    <bpmn:sequenceFlow id="Fluxo_f5" sourceRef="d2" targetRef="a1" name="Sim"/>
    <bpmn:sequenceFlow id="Fluxo_f6" sourceRef="d2" targetRef="f2" name="Não"/>
    <bpmn:sequenceFlow id="Fluxo_f7" sourceRef="a2" targetRef="f"/>
  </bpmn:process>
