      <bpmn:incoming>Fluxo_f4</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f5</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a2" name="Aprovar reembolso">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a2&quot;,&quot;nome&quot;:&quot;Aprovar reembolso&quot;,&quot;papel&quot;:&quot;ger&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f3</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f7</bpmn:outgoing>
