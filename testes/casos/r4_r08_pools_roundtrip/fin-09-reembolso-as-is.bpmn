  <bpmn:collaboration id="Colaboracao.Processo_FIN-09">
    <bpmn:participant id="Pool.Processo_FIN-09" name="FIN-09 · Reembolso" processRef="Processo_FIN-09"/>
    <bpmn:participant id="PoolExt.1" name="Colaborador"/>
    <bpmn:messageFlow id="MsgFlow.1" name="Enviar comprovantes" sourceRef="i" targetRef="PoolExt.1"/>
    <bpmn:messageFlow id="MsgFlow.2" name="Enviar comprovantes" sourceRef="PoolExt.1" targetRef="a1"/>
    <bpmn:messageFlow id="MsgFlow.3" name="Complementar comprovantes" sourceRef="d1" targetRef="PoolExt.1"/>
    <bpmn:messageFlow id="MsgFlow.4" name="Complementar comprovantes" sourceRef="PoolExt.1" targetRef="d2"/>
  </bpmn:collaboration>
  <bpmn:process id="Processo_FIN-09" name="FIN-09 · Reembolso" isExecutable="false">
    <bpmn:extensionElements><senku:carta>{&quot;processo&quot;:{&quot;nome&quot;:&quot;Reembolso&quot;,&quot;codigo&quot;:&quot;FIN-09&quot;},&quot;papeis&quot;:[{&quot;id&quot;:&quot;ana&quot;,&quot;nome&quot;:&quot;Analista Financeiro&quot;},{&quot;id&quot;:&quot;ger&quot;,&quot;nome&quot;:&quot;Gerente&quot;}]}</senku:carta></bpmn:extensionElements>
    <bpmn:laneSet id="Raias.Processo_FIN-09">
