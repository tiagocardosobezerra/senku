      <bpmndi:BPMNShape id="c1.di" bpmnElement="c1"><dc:Bounds x="720" y="55" width="50" height="50"/>
<bpmndi:BPMNLabel><dc:Bounds x="650" y="21" width="100" height="27"/></bpmndi:BPMNLabel>
</bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1.di" bpmnElement="e1"><dc:Bounds x="915" y="60" width="40" height="40"/>
<bpmndi:BPMNLabel><dc:Bounds x="885" y="104" width="100" height="27"/></bpmndi:BPMNLabel>
</bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2.di" bpmnElement="e2"><dc:Bounds x="915" y="180" width="40" height="40"/>
<bpmndi:BPMNLabel><dc:Bounds x="885" y="224" width="100" height="27"/></bpmndi:BPMNLabel>
</bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e3.di" bpmnElement="e3"><dc:Bounds x="915" y="300" width="40" height="40"/>
<bpmndi:BPMNLabel><dc:Bounds x="885" y="344" width="100" height="27"/></bpmndi:BPMNLabel>
</bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a3.di" bpmnElement="a3"><dc:Bounds x="1060" y="405" width="130" height="70"/>
</bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="f.di" bpmnElement="f"><dc:Bounds x="1295" y="420" width="40" height="40"/>
<bpmndi:BPMNLabel><dc:Bounds x="1265" y="464" width="100" height="27"/></bpmndi:BPMNLabel>
</bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="f2.di" bpmnElement="f2"><dc:Bounds x="1105" y="180" width="40" height="40"/>
<bpmndi:BPMNLabel><dc:Bounds x="1075" y="224" width="100" height="27"/></bpmndi:BPMNLabel>
</bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="f3.di" bpmnElement="f3"><dc:Bounds x="1105" y="300" width="40" height="40"/>
<bpmndi:BPMNLabel><dc:Bounds x="1075" y="344" width="100" height="27"/></bpmndi:BPMNLabel>
</bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Fluxo_f1.di" bpmnElement="Fluxo_f1">
        <di:waypoint x="195" y="80"/>
