<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:senku="http://senku/carta" id="Definicoes.Processo_senku" targetNamespace="http://senku/processos" exporter="Senku" exporterVersion="2">
  <bpmn:message id="Msg.a2_2" name="Cliente cancelou o chamado"/>
  <bpmn:collaboration id="Colaboracao.Processo_senku">
    <bpmn:participant id="Pool.Processo_senku" name="Atendimento com muitas exceções" processRef="Processo_senku"/>
  </bpmn:collaboration>
  <bpmn:process id="Processo_senku" name="Atendimento com muitas exceções" isExecutable="false">
    <bpmn:extensionElements><senku:carta>{&quot;processo&quot;:{&quot;nome&quot;:&quot;Atendimento com muitas exceções&quot;},&quot;papeis&quot;:[{&quot;id&quot;:&quot;at&quot;,&quot;nome&quot;:&quot;Atendente&quot;},{&quot;id&quot;:&quot;sup&quot;,&quot;nome&quot;:&quot;Supervisor&quot;},{&quot;id&quot;:&quot;ti&quot;,&quot;nome&quot;:&quot;TI&quot;}]}</senku:carta></bpmn:extensionElements>
    <bpmn:laneSet id="Raias.Processo_senku">
      <bpmn:lane id="Raia_at" name="Atendente">
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_sup" name="Supervisor">
        <bpmn:flowNodeRef>a5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_ti" name="TI">
        <bpmn:flowNodeRef>a7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i" name="Chamado aberto">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;i&quot;,&quot;tipo&quot;:&quot;inicio&quot;,&quot;nome&quot;:&quot;Chamado aberto&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:outgoing>Fluxo_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="a1" name="Registrar chamado">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a1&quot;,&quot;nome&quot;:&quot;Registrar chamado&quot;,&quot;papel&quot;:&quot;at&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f1</bpmn:incoming>
      <bpmn:incoming>Fluxo_f13</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a2" name="Analisar chamado">
      <bpmn:documentation>Tempo: execucao 30min, espera 4h</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a2&quot;,&quot;nome&quot;:&quot;Analisar chamado&quot;,&quot;papel&quot;:&quot;at&quot;,&quot;tempo&quot;:{&quot;execucao&quot;:&quot;30min&quot;,&quot;espera&quot;:&quot;4h&quot;},&quot;bordas&quot;:[{&quot;gatilho&quot;:&quot;tempo&quot;,&quot;nome&quot;:&quot;Prazo de 8 horas corridas estourado&quot;,&quot;tempo&quot;:&quot;8hc&quot;,&quot;percentual&quot;:10,&quot;segue&quot;:&quot;a5&quot;},{&quot;gatilho&quot;:&quot;mensagem&quot;,&quot;nome&quot;:&quot;Cliente cancelou o chamado&quot;,&quot;percentual&quot;:5,&quot;segue&quot;:&quot;fc&quot;},{&quot;gatilho&quot;:&quot;tempo&quot;,&quot;nome&quot;:&quot;Lembrete de 2h&quot;,&quot;tempo&quot;:&quot;2h&quot;,&quot;interrompe&quot;:false,&quot;percentual&quot;:30,&quot;segue&quot;:&quot;a6&quot;},{&quot;gatilho&quot;:&quot;erro&quot;,&quot;nome&quot;:&quot;Sistema fora do ar&quot;,&quot;percentual&quot;:3,&quot;segue&quot;:&quot;a7&quot;},{&quot;gatilho&quot;:&quot;sinal&quot;,&quot;nome&quot;:&quot;Incidente geral declarado&quot;,&quot;percentual&quot;:2,&quot;segue&quot;:&quot;a1&quot;}]}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f2</bpmn:incoming>
      <bpmn:incoming>Fluxo_f15</bpmn:incoming>
      <bpmn:incoming>Fluxo_f17</bpmn:incoming>
      <bpmn:incoming>Fluxo_f19</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="a2_1" name="Prazo de 8 horas corridas estourado" attachedToRef="a2">
      <bpmn:documentation>Tempo: espera 8hc</bpmn:documentation>
      <bpmn:outgoing>Fluxo_f5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="a2_1.def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT8H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="a2_2" name="Cliente cancelou o chamado" attachedToRef="a2">
      <bpmn:outgoing>Fluxo_f7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a2_2.def" messageRef="Msg.a2_2"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="a2_3" name="Lembrete de 2h" attachedToRef="a2" cancelActivity="false">
      <bpmn:documentation>Tempo: espera 2h</bpmn:documentation>
      <bpmn:outgoing>Fluxo_f9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="a2_3.def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="a2_4" name="Sistema fora do ar" attachedToRef="a2">
      <bpmn:outgoing>Fluxo_f11</bpmn:outgoing>
      <bpmn:errorEventDefinition id="a2_4.def"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="a2_5" name="Incidente geral declarado" attachedToRef="a2">
      <bpmn:outgoing>Fluxo_f13</bpmn:outgoing>
      <bpmn:signalEventDefinition id="a2_5.def"/>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="d1" name="Resolvido?">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;d1&quot;,&quot;tipo&quot;:&quot;decisao&quot;,&quot;nome&quot;:&quot;Resolvido?&quot;,&quot;papel&quot;:&quot;at&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f3</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f14</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a3" name="Encerrar chamado">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a3&quot;,&quot;nome&quot;:&quot;Encerrar chamado&quot;,&quot;papel&quot;:&quot;at&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f14</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a5" name="Escalar chamado">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a5&quot;,&quot;nome&quot;:&quot;Escalar chamado&quot;,&quot;papel&quot;:&quot;sup&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f5</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a6" name="Avisar supervisor">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a6&quot;,&quot;nome&quot;:&quot;Avisar supervisor&quot;,&quot;papel&quot;:&quot;sup&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f9</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a7" name="Abrir incidente técnico">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a7&quot;,&quot;nome&quot;:&quot;Abrir incidente técnico&quot;,&quot;papel&quot;:&quot;ti&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f11</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="f" name="Chamado resolvido">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;f&quot;,&quot;tipo&quot;:&quot;fim&quot;,&quot;nome&quot;:&quot;Chamado resolvido&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="f2" name="Supervisor avisado">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;f2&quot;,&quot;tipo&quot;:&quot;fim&quot;,&quot;nome&quot;:&quot;Supervisor avisado&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="fc" name="Chamado cancelado">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;fc&quot;,&quot;tipo&quot;:&quot;fim&quot;,&quot;nome&quot;:&quot;Chamado cancelado&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_f1" sourceRef="i" targetRef="a1"/>
    <bpmn:sequenceFlow id="Fluxo_f2" sourceRef="a1" targetRef="a2"/>
    <bpmn:sequenceFlow id="Fluxo_f3" sourceRef="a2" targetRef="d1"/>
