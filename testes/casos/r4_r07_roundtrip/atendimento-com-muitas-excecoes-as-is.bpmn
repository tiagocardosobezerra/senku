    <bpmn:sequenceFlow id="Fluxo_f13" sourceRef="a2_5" targetRef="a1"/>
    <bpmn:sequenceFlow id="Fluxo_f14" sourceRef="d1" targetRef="a3" name="Sim">
      <bpmn:documentation>70% dos casos</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;percentual&quot;:70.0}</senku:dados></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_f15" sourceRef="d1" targetRef="a2" name="Não, reanalisar">
      <bpmn:documentation>30% dos casos</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;percentual&quot;:30.0}</senku:dados></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_f16" sourceRef="a3" targetRef="f"/>
    <bpmn:sequenceFlow id="Fluxo_f17" sourceRef="a5" targetRef="a2"/>
    <bpmn:sequenceFlow id="Fluxo_f18" sourceRef="a6" targetRef="f2"/>
    <bpmn:sequenceFlow id="Fluxo_f19" sourceRef="a7" targetRef="a2"/>
