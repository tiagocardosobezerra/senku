<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:senku="http://senku/carta" id="Definicoes.Processo_CRE-02" targetNamespace="http://senku/processos" exporter="Senku" exporterVersion="2">
  <bpmn:message id="Msg.inicio" name="Pedido de crédito recebido"/>
  <bpmn:collaboration id="Colaboracao.Processo_CRE-02">
    <bpmn:participant id="Pool.Processo_CRE-02" name="CRE-02 · Concessão de limite de crédito para cliente PJ" processRef="Processo_CRE-02"/>
  </bpmn:collaboration>
  <bpmn:process id="Processo_CRE-02" name="CRE-02 · Concessão de limite de crédito para cliente PJ" isExecutable="false">
    <bpmn:documentation>Liberar limite de crédito para clientes pessoa jurídica com risco aceitável, no menor prazo, dentro da política de crédito e das alçadas.</bpmn:documentation>
    <bpmn:extensionElements><senku:carta>{&quot;formato&quot;:&quot;senku/1&quot;,&quot;processo&quot;:{&quot;codigo&quot;:&quot;CRE-02&quot;,&quot;nome&quot;:&quot;Concessão de limite de crédito para cliente PJ&quot;,&quot;cenario&quot;:&quot;as-is&quot;,&quot;versao&quot;:&quot;0.4&quot;,&quot;objetivo&quot;:&quot;Liberar limite de crédito para clientes pessoa jurídica com risco aceitável, no menor prazo, dentro da política de crédito e das alçadas.&quot;,&quot;dono&quot;:&quot;Gerente de Crédito e Cobrança&quot;,&quot;area&quot;:&quot;Financeiro&quot;,&quot;macroprocesso&quot;:&quot;Gestão de receitas&quot;,&quot;nivel&quot;:&quot;processo&quot;,&quot;gatilho&quot;:&quot;Vendedor recebe pedido de cliente novo ou pedido de aumento de limite&quot;,&quot;resultado&quot;:&quot;Limite cadastrado no ERP e contrato assinado, ou recusa comunicada ao cliente&quot;,&quot;frequencia&quot;:&quot;contínuo&quot;,&quot;volume&quot;:&quot;cerca de 260 propostas por mês (70% clientes novos)&quot;,&quot;prazo_informado&quot;:&quot;de 5 a 20 dias úteis; o comercial reclama dos casos que vão a comitê&quot;,&quot;escopo&quot;:{&quot;inicio&quot;:&quot;Vendedor registra a proposta de crédito&quot;,&quot;fim&quot;:&quot;Limite liberado no ERP, ou cliente informado da recusa ou da expiração&quot;,&quot;inclui&quot;:[&quot;clientes novos&quot;,&quot;aumento de limite de clientes ativos&quot;],&quot;nao_inclui&quot;:[&quot;renovação anual automática (CRE-03)&quot;,&quot;cobrança e bloqueio por atraso (CRE-05)&quot;,&quot;venda à vista&quot;]},&quot;normas&quot;:[&quot;Política de Crédito POL-FIN-07 rev. 3&quot;,&quot;Matriz de alçadas de crédito 2026&quot;,&quot;Procedimento KYC / PLD (Lei 9.613/1998)&quot;],&quot;premissas&quot;:[&quot;Tempos e percentuais estimados nas entrevistas de 21 e 22/10/2026&quot;,&quot;Score do bureau consultado por integração automática do ERP&quot;]},&quot;sipoc&quot;:{&quot;fornecedores&quot;:[&quot;Cliente PJ&quot;,&quot;Vendedor&quot;,&quot;Bureau de crédito&quot;,&quot;Receita Federal (consulta CNPJ)&quot;],&quot;entradas&quot;:[&quot;Proposta de crédito&quot;,&quot;Contrato social e balanço&quot;,&quot;Score e restrições do bureau&quot;,&quot;Política e alçadas&quot;],&quot;saidas&quot;:[&quot;Parecer de crédito&quot;,&quot;Contrato de crédito assinado&quot;,&quot;Limite cadastrado no ERP&quot;,&quot;Comunicação de recusa&quot;],&quot;clientes&quot;:[&quot;Cliente PJ&quot;,&quot;Área Comercial&quot;,&quot;Faturamento&quot;]},&quot;papeis&quot;:[{&quot;id&quot;:&quot;cliente&quot;,&quot;nome&quot;:&quot;Cliente PJ&quot;,&quot;tipo&quot;:&quot;externo&quot;},{&quot;id&quot;:&quot;vendedor&quot;,&quot;nome&quot;:&quot;Vendedor&quot;,&quot;tipo&quot;:&quot;interno&quot;},{&quot;id&quot;:&quot;cadastro&quot;,&quot;nome&quot;:&quot;Cadastro&quot;,&quot;tipo&quot;:&quot;interno&quot;},{&quot;id&quot;:&quot;erp&quot;,&quot;nome&quot;:&quot;ERP (automático)&quot;,&quot;tipo&quot;:&quot;sistema&quot;},{&quot;id&quot;:&quot;analista&quot;,&quot;nome&quot;:&quot;Analista de Crédito&quot;,&quot;tipo&quot;:&quot;interno&quot;},{&quot;id&quot;:&quot;comite&quot;,&quot;nome&quot;:&quot;Comitê de Crédito&quot;,&quot;tipo&quot;:&quot;interno&quot;},{&quot;id&quot;:&quot;juridico&quot;,&quot;nome&quot;:&quot;Jurídico&quot;,&quot;tipo&quot;:&quot;interno&quot;}],&quot;sistemas&quot;:[{&quot;id&quot;:&quot;crm&quot;,&quot;nome&quot;:&quot;CRM&quot;,&quot;descricao&quot;:&quot;Salesforce&quot;},{&quot;id&quot;:&quot;sis_erp&quot;,&quot;nome&quot;:&quot;ERP&quot;,&quot;descricao&quot;:&quot;TOTVS Protheus&quot;},{&quot;id&quot;:&quot;bureau&quot;,&quot;nome&quot;:&quot;Bureau&quot;,&quot;descricao&quot;:&quot;Serasa Experian, via integração&quot;},{&quot;id&quot;:&quot;email&quot;,&quot;nome&quot;:&quot;E-mail&quot;},{&quot;id&quot;:&quot;planilha&quot;,&quot;nome&quot;:&quot;Planilha de análise&quot;},{&quot;id&quot;:&quot;docusign&quot;,&quot;nome&quot;:&quot;DocuSign&quot;}],&quot;regras&quot;:[{&quot;id&quot;:&quot;R1&quot;,&quot;texto&quot;:&quot;Sem contrato social atualizado, dois últimos balanços e cartão CNPJ ativo, a proposta não segue.&quot;,&quot;fonte&quot;:&quot;POL-FIN-07, item 3.1&quot;},{&quot;id&quot;:&quot;R2&quot;,&quot;texto&quot;:&quot;Sócio em lista restritiva ou PEP sem diligência reforçada: recusa obrigatória.&quot;,&quot;fonte&quot;:&quot;Procedimento KYC/PLD&quot;},{&quot;id&quot;:&quot;R3&quot;,&quot;texto&quot;:&quot;Score ≥ 700 e limite até R$ 50 mil: aprovação automática. Score &lt; 400 ou protesto ativo: recusa. Demais: análise manual.&quot;,&quot;fonte&quot;:&quot;POL-FIN-07, item 4&quot;},{&quot;id&quot;:&quot;R4&quot;,&quot;texto&quot;:&quot;Liquidez corrente mínima de 1,0 e endividamento até 70% do patrimônio líquido.&quot;,&quot;fonte&quot;:&quot;POL-FIN-07, item 5.2&quot;},{&quot;id&quot;:&quot;R5&quot;,&quot;texto&quot;:&quot;Analista aprova até R$ 200 mil; gerente até R$ 500 mil; acima disso, comitê.&quot;,&quot;fonte&quot;:&quot;Matriz de alçadas 2026&quot;},{&quot;id&quot;:&quot;R6&quot;,&quot;texto&quot;:&quot;Contrato não assinado em 10 dias corridos expira; nova proposta reinicia a análise.&quot;,&quot;fonte&quot;:&quot;POL-FIN-07, item 7&quot;},{&quot;id&quot;:&quot;R7&quot;,&quot;texto&quot;:&quot;A recusa não informa o motivo detalhado de score; o vendedor oferece venda à vista ou com garantia.&quot;,&quot;fonte&quot;:&quot;Jurídico&quot;}],&quot;indicadores&quot;:[{&quot;nome&quot;:&quot;Prazo de concessão&quot;,&quot;formula&quot;:&quot;data de desbloqueio - data da proposta (dias úteis), mediana&quot;,&quot;meta&quot;:&quot;≤ 5 dias úteis&quot;,&quot;polaridade&quot;:&quot;menor é melhor&quot;,&quot;periodicidade&quot;:&quot;mensal&quot;,&quot;fonte&quot;:&quot;CRM + ERP&quot;,&quot;dono&quot;:&quot;Gerente de Crédito e Cobrança&quot;,&quot;atual&quot;:&quot;9 dias úteis (mediana set/2026)&quot;},{&quot;nome&quot;:&quot;Taxa de aprovação automática&quot;,&quot;formula&quot;:&quot;propostas aprovadas sem análise manual / propostas analisadas&quot;,&quot;meta&quot;:&quot;≥ 50%&quot;,&quot;polaridade&quot;:&quot;maior é melhor&quot;,&quot;periodicidade&quot;:&quot;mensal&quot;,&quot;fonte&quot;:&quot;ERP&quot;,&quot;dono&quot;:&quot;Gerente de Crédito e Cobrança&quot;,&quot;atual&quot;:&quot;40%&quot;},{&quot;nome&quot;:&quot;Inadimplência da safra&quot;,&quot;formula&quot;:&quot;valor vencido &gt; 60 dias / limite liberado, por mês de concessão&quot;,&quot;meta&quot;:&quot;≤ 2,5%&quot;,&quot;polaridade&quot;:&quot;menor é melhor&quot;,&quot;periodicidade&quot;:&quot;mensal&quot;,&quot;fonte&quot;:&quot;ERP&quot;,&quot;dono&quot;:&quot;Gerente de Crédito e Cobrança&quot;,&quot;atual&quot;:&quot;2,1%&quot;},{&quot;nome&quot;:&quot;Retrabalho de documentação&quot;,&quot;formula&quot;:&quot;propostas devolvidas por documento / propostas recebidas&quot;,&quot;meta&quot;:&quot;≤ 15%&quot;,&quot;polaridade&quot;:&quot;menor é melhor&quot;,&quot;periodicidade&quot;:&quot;mensal&quot;,&quot;fonte&quot;:&quot;CRM&quot;,&quot;dono&quot;:&quot;Coordenador Comercial&quot;,&quot;atual&quot;:&quot;35%&quot;}],&quot;dores&quot;:[{&quot;id&quot;:&quot;D1&quot;,&quot;descricao&quot;:&quot;35% das propostas voltam por documento faltando; o cliente manda aos poucos por e-mail.&quot;,&quot;elementos&quot;:[&quot;a2&quot;,&quot;c1&quot;,&quot;a3&quot;],&quot;impacto&quot;:&quot;alto&quot;,&quot;frequencia&quot;:&quot;35%&quot;},{&quot;id&quot;:&quot;D2&quot;,&quot;descricao&quot;:&quot;Proposta acima da alçada espera a reunião quinzenal do comitê (até 15 dias).&quot;,&quot;elementos&quot;:[&quot;e1&quot;,&quot;a6&quot;],&quot;impacto&quot;:&quot;alto&quot;,&quot;frequencia&quot;:&quot;15% do total&quot;},{&quot;id&quot;:&quot;D3&quot;,&quot;descricao&quot;:&quot;Análise manual em planilha fora do ERP: parecer não fica no histórico do cliente.&quot;,&quot;elementos&quot;:[&quot;a4&quot;],&quot;impacto&quot;:&quot;médio&quot;}],&quot;riscos&quot;:[{&quot;id&quot;:&quot;K1&quot;,&quot;descricao&quot;:&quot;Liberar limite sem contrato assinado&quot;,&quot;elementos&quot;:[&quot;a8&quot;,&quot;a9&quot;],&quot;controle&quot;:&quot;Limite cadastrado bloqueado; desbloqueio só após o paralelo (contrato + cadastro)&quot;,&quot;tipo_controle&quot;:&quot;preventivo&quot;,&quot;probabilidade&quot;:&quot;baixa&quot;,&quot;impacto&quot;:&quot;alto&quot;},{&quot;id&quot;:&quot;K2&quot;,&quot;descricao&quot;:&quot;Conceder crédito a empresa com sócio sancionado (PLD)&quot;,&quot;elementos&quot;:[&quot;s1&quot;],&quot;controle&quot;:&quot;Checagem KYC obrigatória antes do bureau (R2)&quot;,&quot;tipo_controle&quot;:&quot;preventivo&quot;,&quot;probabilidade&quot;:&quot;baixa&quot;,&quot;impacto&quot;:&quot;muito alto&quot;},{&quot;id&quot;:&quot;K3&quot;,&quot;descricao&quot;:&quot;Analista aprovar acima da própria alçada&quot;,&quot;elementos&quot;:[&quot;d3&quot;],&quot;controle&quot;:&quot;Alçada parametrizada no ERP por usuário&quot;,&quot;tipo_controle&quot;:&quot;preventivo&quot;,&quot;probabilidade&quot;:&quot;média&quot;,&quot;impacto&quot;:&quot;médio&quot;},{&quot;id&quot;:&quot;K4&quot;,&quot;descricao&quot;:&quot;Limite liberado diferente do aprovado&quot;,&quot;elementos&quot;:[&quot;a8&quot;],&quot;controle&quot;:&quot;&quot;,&quot;tipo_controle&quot;:&quot;&quot;,&quot;probabilidade&quot;:&quot;média&quot;,&quot;impacto&quot;:&quot;alto&quot;}],&quot;melhorias&quot;:[{&quot;id&quot;:&quot;M1&quot;,&quot;descricao&quot;:&quot;Portal do cliente com checklist e upload obrigatório de documentos&quot;,&quot;resolve&quot;:[&quot;D1&quot;],&quot;elementos&quot;:[&quot;a2&quot;,&quot;c1&quot;],&quot;impacto&quot;:&quot;alto&quot;,&quot;esforco&quot;:&quot;médio&quot;,&quot;responsavel&quot;:&quot;Coordenador Comercial&quot;,&quot;prazo&quot;:&quot;31/01/2027&quot;,&quot;status&quot;:&quot;em andamento&quot;},{&quot;id&quot;:&quot;M2&quot;,&quot;descricao&quot;:&quot;Comitê virtual assíncrono (aprovação no ERP em até 48h) para limites entre R$ 500 mil e R$ 1 milhão&quot;,&quot;resolve&quot;:[&quot;D2&quot;],&quot;elementos&quot;:[&quot;e1&quot;,&quot;a6&quot;],&quot;impacto&quot;:&quot;alto&quot;,&quot;esforco&quot;:&quot;baixo&quot;,&quot;responsavel&quot;:&quot;Gerente de Crédito e Cobrança&quot;,&quot;prazo&quot;:&quot;15/12/2026&quot;,&quot;status&quot;:&quot;aprovada&quot;},{&quot;id&quot;:&quot;M3&quot;,&quot;descricao&quot;:&quot;Parecer de crédito em formulário do ERP, anexado ao cadastro do cliente&quot;,&quot;resolve&quot;:[&quot;D3&quot;],&quot;elementos&quot;:[&quot;a4&quot;],&quot;impacto&quot;:&quot;médio&quot;,&quot;esforco&quot;:&quot;médio&quot;,&quot;responsavel&quot;:&quot;TI - ERP&quot;,&quot;prazo&quot;:&quot;31/03/2027&quot;,&quot;status&quot;:&quot;proposta&quot;}],&quot;glossario&quot;:[{&quot;termo&quot;:&quot;KYC&quot;,&quot;definicao&quot;:&quot;Know Your Customer: identificação e verificação de quem é o cliente e seus sócios.&quot;},{&quot;termo&quot;:&quot;PLD&quot;,&quot;definicao&quot;:&quot;Prevenção à lavagem de dinheiro (Lei 9.613/1998).&quot;},{&quot;termo&quot;:&quot;PEP&quot;,&quot;definicao&quot;:&quot;Pessoa exposta politicamente.&quot;},{&quot;termo&quot;:&quot;Alçada&quot;,&quot;definicao&quot;:&quot;Valor máximo que cada cargo pode aprovar sozinho.&quot;}],&quot;pendencias&quot;:[{&quot;pergunta&quot;:&quot;Quem confere se o limite cadastrado no ERP é igual ao aprovado (K4 sem controle)?&quot;,&quot;para&quot;:&quot;Gerente de Crédito e Cobrança&quot;},{&quot;pergunta&quot;:&quot;A faixa do gerente (R$ 200 a 500 mil) passa pelo analista ou vai direto? O fluxo atual manda tudo acima da alçada do analista ao comitê.&quot;,&quot;para&quot;:&quot;Gerente de Crédito e Cobrança&quot;}]}</senku:carta></bpmn:extensionElements>
    <bpmn:laneSet id="Raias.Processo_CRE-02">
      <bpmn:lane id="Raia_cliente" name="Cliente PJ">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_vendedor" name="Vendedor">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_rec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_cadastro" name="Cadastro">
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_erp" name="ERP (automático)">
        <bpmn:flowNodeRef>x1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_analista" name="Analista de Crédito">
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a4_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_comite" name="Comitê de Crédito">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_juridico" name="Jurídico">
        <bpmn:flowNodeRef>a7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_exp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Pedido de crédito recebido">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;inicio&quot;,&quot;tipo&quot;:&quot;inicio&quot;,&quot;gatilho&quot;:&quot;mensagem&quot;,&quot;nome&quot;:&quot;Pedido de crédito recebido&quot;,&quot;papel&quot;:&quot;vendedor&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:outgoing>Fluxo_f1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="inicio.def" messageRef="Msg.inicio"/>
    </bpmn:startEvent>
    <bpmn:userTask id="a1" name="Registrar proposta de crédito">
      <bpmn:documentation>Abre a proposta no CRM com CNPJ, limite pedido, prazo de pagamento e previsão de compra mensal.&#10;Sistema: CRM&#10;Tempo: execucao 20min&#10;Valor: NAV-N</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a1&quot;,&quot;nome&quot;:&quot;Registrar proposta de crédito&quot;,&quot;papel&quot;:&quot;vendedor&quot;,&quot;sistema&quot;:&quot;crm&quot;,&quot;descricao&quot;:&quot;Abre a proposta no CRM com CNPJ, limite pedido, prazo de pagamento e previsão de compra mensal.&quot;,&quot;saidas&quot;:[&quot;Proposta de crédito&quot;],&quot;tempo&quot;:{&quot;execucao&quot;:&quot;20min&quot;},&quot;valor&quot;:&quot;NAV-N&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f1</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a2" name="Solicitar documentos ao cliente">
      <bpmn:documentation>Pede contrato social, dois últimos balanços e cartão CNPJ.&#10;Sistema: E-mail&#10;Tempo: execucao 10min&#10;Valor: NAV-N</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a2&quot;,&quot;nome&quot;:&quot;Solicitar documentos ao cliente&quot;,&quot;papel&quot;:&quot;vendedor&quot;,&quot;sistema&quot;:&quot;email&quot;,&quot;descricao&quot;:&quot;Pede contrato social, dois últimos balanços e cartão CNPJ.&quot;,&quot;tempo&quot;:{&quot;execucao&quot;:&quot;10min&quot;},&quot;valor&quot;:&quot;NAV-N&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f2</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="c1" name="Enviar documentos">
      <bpmn:documentation>Sistema: E-mail&#10;Tempo: execucao 30min, espera 3d&#10;Valor: NAV-N</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;c1&quot;,&quot;nome&quot;:&quot;Enviar documentos&quot;,&quot;papel&quot;:&quot;cliente&quot;,&quot;sistema&quot;:&quot;email&quot;,&quot;tempo&quot;:{&quot;execucao&quot;:&quot;30min&quot;,&quot;espera&quot;:&quot;3d&quot;},&quot;valor&quot;:&quot;NAV-N&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f3</bpmn:incoming>
      <bpmn:incoming>Fluxo_f8</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a3" name="Conferir documentação">
      <bpmn:documentation>Sistema: CRM&#10;Tempo: execucao 25min, espera 1d&#10;Regra R1: Sem contrato social atualizado, dois últimos balanços e cartão CNPJ ativo, a proposta não segue.&#10;Valor: NAV-N</bpmn:documentation>
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;a3&quot;,&quot;nome&quot;:&quot;Conferir documentação&quot;,&quot;papel&quot;:&quot;cadastro&quot;,&quot;sistema&quot;:&quot;crm&quot;,&quot;regras&quot;:[&quot;R1&quot;],&quot;como&quot;:[&quot;Conferir CNPJ ativo na Receita&quot;,&quot;Conferir se o signatário consta no contrato social&quot;,&quot;Conferir balanço assinado por contador&quot;],&quot;tempo&quot;:{&quot;execucao&quot;:&quot;25min&quot;,&quot;espera&quot;:&quot;1d&quot;},&quot;valor&quot;:&quot;NAV-N&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f4</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="d1" name="Documentação completa?">
      <bpmn:extensionElements><senku:dados>{&quot;id&quot;:&quot;d1&quot;,&quot;tipo&quot;:&quot;decisao&quot;,&quot;nome&quot;:&quot;Documentação completa?&quot;,&quot;papel&quot;:&quot;cadastro&quot;}</senku:dados></bpmn:extensionElements>
      <bpmn:incoming>Fluxo_f5</bpmn:incoming>
      <bpmn:outgoing>Fluxo_f6</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_f7</bpmn:outgoing>
